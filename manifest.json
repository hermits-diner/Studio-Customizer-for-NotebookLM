{
  "manifest_version": 3,
  "name": "Studio Customizer for NotebookLM",
  "version": "0.5.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "storage", "clipboardWrite", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://notebooklm.google.com/*",
    "https://raw.githubusercontent.com/hermits-diner/Studio-Customizer-for-NotebookLM/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://notebooklm.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
